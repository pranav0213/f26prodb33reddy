
extends layout

block content
  h1= title
  p Welcome to #{title}

  button.btn.btn-primary(type="button", onclick="reduce()") Reduce

  div#use take some away

  script.
    let current = 11;
    let quantity = 2;

    function reduce() {
      current = current - quantity;

      if (current < 0) {
        current = 0;
      }

      document.getElementById("use").innerHTML =
        `Reduced by ${quantity} to ${current}`;
    }
